#!/bin/bash
# Engram — Initialize the layered memory system in any project.
# Layers are defined once in lib/layers.py; this script never names them.
#
# Usage:
#   engram init [project-dir] [--template <name>]
#
# Creates:
#   .claude/memory/<layer>/ for every layer in lib/layers.py
#   .claude/scripts/engram-* (symlinks to global install)
#   Appends Engram protocol to CLAUDE.md (if not present)
#
# Templates:
#   --template <name>   Seed with domain knowledge from templates/<name>/
#
# Dependencies (optional):
#   - Ollama with nomic-embed-text model (for semantic search)
#   - ripgrep (for keyword search fallback)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# Layer registry — single source of truth for memory layers
# shellcheck source=../lib/layers.sh
source "$SCRIPT_DIR/../lib/layers.sh"
ENGRAM_HOME="${ENGRAM_HOME:-$HOME/.engram}"

# Parse args
TEMPLATE=""
PROJECT_DIR="."
while [[ $# -gt 0 ]]; do
  case "$1" in
    --template)
      TEMPLATE="$2"
      shift 2
      ;;
    --template=*)
      TEMPLATE="${1#*=}"
      shift
      ;;
    *)
      PROJECT_DIR="$1"
      shift
      ;;
  esac
done

cd "$PROJECT_DIR"

echo "Engram: initializing $(engram_layer_count)-layer memory in $(pwd)"

# 1. Create directory structure
for layer in $(engram_layers all); do
  mkdir -p ".claude/memory/$layer"
done
mkdir -p .claude/scripts

echo "  Created .claude/memory/$(engram_layers_brace all)/"

# 2. Seed active layer files
if [ ! -f .claude/memory/active/current-tasks.md ]; then
  cat > .claude/memory/active/current-tasks.md << 'SEED'
# Current Tasks

_No active tasks yet. Update this file as you work._
SEED
  echo "  Seeded active/current-tasks.md"
fi

if [ ! -f .claude/memory/active/context-inject.md ]; then
  echo "# Context Inject — auto-populated by engram start" > .claude/memory/active/context-inject.md
  echo "  Seeded active/context-inject.md"
fi

# 3. Symlink scripts to global install
for script in engram-start engram-end engram-search engram-sync engram-status; do
  if [ -f "$SCRIPT_DIR/$script" ]; then
    ln -sf "$SCRIPT_DIR/$script" ".claude/scripts/$script"
  fi
done
echo "  Symlinked scripts → $(dirname "$SCRIPT_DIR")"

# 4. Template seeding
if [ -n "$TEMPLATE" ]; then
  # Look for template in: ENGRAM_HOME/templates/, then repo templates/
  TEMPLATE_DIR=""
  for candidate in "$ENGRAM_HOME/templates/$TEMPLATE" "$SCRIPT_DIR/../templates/$TEMPLATE"; do
    if [ -d "$candidate" ]; then
      TEMPLATE_DIR="$(cd "$candidate" && pwd)"
      break
    fi
  done

  if [ -z "$TEMPLATE_DIR" ]; then
    echo "  WARNING: template '$TEMPLATE' not found."
    echo "  Searched: $ENGRAM_HOME/templates/$TEMPLATE"
    echo "           $SCRIPT_DIR/../templates/$TEMPLATE"
  else
    echo ""
    echo "  Seeding template: $TEMPLATE ($TEMPLATE_DIR)"

    for layer in $(engram_layers transferable); do
      if [ -d "$TEMPLATE_DIR/$layer" ]; then
        for f in "$TEMPLATE_DIR/$layer/"*; do
          [ -f "$f" ] || continue
          fname=$(basename "$f")
          if [ ! -f ".claude/memory/$layer/$fname" ]; then
            cp "$f" ".claude/memory/$layer/$fname"
            echo "    $layer/$fname"
          else
            echo "    $layer/$fname (exists, skipped)"
          fi
        done
      fi
    done

    echo "  Template '$TEMPLATE' seeded!"
  fi
fi

# 5. Add .gitignore for cache
if [ ! -f .claude/memory/.gitignore ]; then
  cat > .claude/memory/.gitignore << 'GI'
.cache/
GI
fi

# 5b. Install or refresh schema.md.
# schema.md documents the layers, so it goes stale when a layer is added. We
# ship the digest of every schema.md we have released; if the project's copy
# matches one of them it was never edited and is safe to refresh. An edited
# schema.md is never overwritten — we say so instead of diverging silently.
# Prefer the schema shipped beside the code actually running. Taking
# $ENGRAM_HOME first meant a checkout installed the OLDER schema from a
# previously installed copy.
for candidate in "$SCRIPT_DIR/../templates/default/schema.md" "$ENGRAM_HOME/templates/default/schema.md"; do
  [ -f "$candidate" ] || continue
  KNOWN_DIGESTS="$(dirname "$candidate")/schema.known-digests"

  if [ ! -f .claude/memory/schema.md ]; then
    cp "$candidate" .claude/memory/schema.md
    echo "  Installed schema.md (knowledge governance rules)"
  else
    current_digest=$(engram_schema_digest .claude/memory/schema.md)
    shipped_digest=$(engram_schema_digest "$candidate")
    if [ "$current_digest" = "$shipped_digest" ]; then
      : # already current
    elif [ -f "$KNOWN_DIGESTS" ] && grep -q "^$current_digest" "$KNOWN_DIGESTS"; then
      cp "$candidate" .claude/memory/schema.md
      echo "  Refreshed schema.md (was unmodified, now documents all layers)"
    else
      echo "  NOTE: schema.md looks edited — left as-is."
      echo "        Newer layer definitions: $candidate"
    fi
  fi
  break
done

# 6. Create or refresh the Engram protocol block in CLAUDE.md.
# The block is fenced, so a refresh rewrites only the generated part and leaves
# everything a project wrote around it alone.
TEMPLATE_EXTRA=""
if [ -n "$TEMPLATE" ] && [ -n "${TEMPLATE_DIR:-}" ] && [ -f "$TEMPLATE_DIR/claude.md.extra" ]; then
  TEMPLATE_EXTRA="$TEMPLATE_DIR/claude.md.extra"
fi

CLAUDE_MD_STATUS=$(engram_sync_claude_md CLAUDE.md)
case "$CLAUDE_MD_STATUS" in
  created)   echo "  Created CLAUDE.md with Engram protocol" ;;
  updated)   echo "  Updated the Engram protocol in CLAUDE.md ($(engram_layer_count) layers)" ;;
  unchanged) echo "  CLAUDE.md protocol already current" ;;
esac

# Template guidance is appended once, after the fenced block.
if [ -n "$TEMPLATE_EXTRA" ] && ! grep -qF "$(head -1 "$TEMPLATE_EXTRA")" CLAUDE.md; then
  { echo ""; cat "$TEMPLATE_EXTRA"; } >> CLAUDE.md
  echo "  Added $TEMPLATE guidance to CLAUDE.md"
fi

echo ""
echo "Engram initialized! Next steps:"
echo "  engram start \"your topic here\""
echo ""
echo "Optional: install Ollama + nomic-embed-text for semantic search:"
echo "  ollama pull nomic-embed-text"
